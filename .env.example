# Copiez ce fichier en .env puis renseignez vos clés.

# --- Claude (obligatoire) : https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
LIVE_MODEL=claude-sonnet-5-5        # plus rapide : claude-haiku-5-5
REPORT_MODEL=claude-opus-5-5
CANDIDATE_NAME=Ferry
LANGUAGE=fr                          # fr | en | auto

# --- Transcription
# local = faster-whisper sur votre PC (gratuit) | groq = API Groq (plus rapide, clé gratuite)
STT_PROVIDER=groq                    # recommandé : bien plus rapide qu'en local sur un PC portable
WHISPER_MODEL=small                  # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                   # cuda si carte NVIDIA
GROQ_API_KEY=

# --- Audio (vide = périphériques par défaut ; sinon une partie du nom, cf. python run.py --devices)
MIC_DEVICE=
LOOPBACK_DEVICE=
SILENCE_MS_THEM=900
SILENCE_MS_ME=700

# --- Dossier candidat depuis Notion (recommandé : aucun fichier local)
# 1. https://www.notion.so/profile/integrations -> Nouvelle intégration interne -> copier le token
# 2. Dans Notion, ouvrir la page « Mon CV décortiqué » -> ••• -> Connexions -> ajouter l'intégration
NOTION_TOKEN=
NOTION_PAGES=https://app.notion.com/p/40550329f195816a8e70d318ae45e855
# Dossier de l'entretien du jour : toujours fourni en entier à Claude (ex. page de candidature Hubvisory)
NOTION_PRIORITY_PAGES=https://app.notion.com/p/41050329f1958114b8fedf63a64409e6

# --- Comportement
AUTO_SUGGEST_ALL=false               # true = suggestion après chaque intervention, même sans question
MAX_CONTEXT_CHARS=60000              # au-delà : recherche RAG au lieu du dossier complet
RAG_TOP_K=5
PORT=8765
